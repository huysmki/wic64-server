{
  // Folders: relative to the project folder (the one with the Makefile), or absolute, e.g. "/Users/Kim/C64/content"
  "Content": "content",
  "Build": "build",

  // Port for the C64 and the web UI (http://localhost:6464/)
  "Port": 6464,

  // Play length of tunes that are not in Songlengths.md5, in seconds
  "SidDefaultSeconds": 180,

  // Allow the web UI from other computers on the network (anyone there can then manage the files)
  "AllowRemoteAdmin": false,

  // Where the Disk tools plugin stores files and disks from the C64's drives (8-11). Empty: "From C64" in content/prg,
  // so uploads show up in the browser and the web UI. Relative to the project folder, or absolute.
  "UploadFolder": "",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
